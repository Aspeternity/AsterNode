[Unit]
Description=Relay Manager managed Xray
Requires=relay-manager-firewall-guard.service
After=network-online.target relay-manager-firewall-guard.service
Wants=network-online.target
ConditionPathExists=/etc/relay-manager-xray/config.json

[Service]
Type=simple
User=rm-xray
Group=rm-xray
ExecStart=/usr/local/lib/relay-manager/core/current/xray run -c /etc/relay-manager-xray/config.json
Restart=on-failure
RestartSec=3s
StartLimitIntervalSec=60s
StartLimitBurst=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/relay-manager-xray
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
